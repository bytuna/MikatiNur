<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:background="@android:color/transparent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/notif_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="13sp"
            android:textColor="#000000"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/notif_timer_container"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:singleLine="true"/>

        <LinearLayout
            android:id="@+id/notif_timer_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/notif_kerahat_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KERAHAT VAKTİ"
                android:textColor="#FF0000"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/notif_current_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#FF9800"
                android:textStyle="bold"
                android:gravity="end"
                android:singleLine="true"/>
        </LinearLayout>
    </RelativeLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#DDDDDD"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:contentDescription="divider"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="-2dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="İmsak" android:textSize="9sp" android:gravity="center" android:id="@+id/label_imsak"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Sabah" android:textSize="9sp" android:gravity="center" android:id="@+id/label_sabah"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Güneş" android:textSize="9sp" android:gravity="center" android:id="@+id/label_sunrise"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Öğle" android:textSize="9sp" android:gravity="center" android:id="@+id/label_dhuhr"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="İkindi" android:textSize="9sp" android:gravity="center" android:id="@+id/label_asr"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Akşam" android:textSize="9sp" android:gravity="center" android:id="@+id/label_maghrib"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Yatsı" android:textSize="9sp" android:gravity="center" android:id="@+id/label_isha"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="-2dp">
        <TextView android:id="@+id/time_imsak" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="00:00" android:textSize="10sp" android:gravity="center" android:textColor="#000000" android:textStyle="bold"/>
        <TextView android:id="@+id/time_sabah" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="00:00" android:textSize="10sp" android:gravity="center" android:textColor="#000000" android:textStyle="bold"/>
        <TextView android:id="@+id/time_sunrise" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="00:00" android:textSize="10sp" android:gravity="center" android:textColor="#000000" android:textStyle="bold"/>
        <TextView android:id="@+id/time_dhuhr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="00:00" android:textSize="10sp" android:gravity="center" android:textColor="#000000" android:textStyle="bold"/>
        <TextView android:id="@+id/time_asr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="00:00" android:textSize="10sp" android:gravity="center" android:textColor="#000000" android:textStyle="bold"/>
        <TextView android:id="@+id/time_maghrib" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="00:00" android:textSize="10sp" android:gravity="center" android:textColor="#000000" android:textStyle="bold"/>
        <TextView android:id="@+id/time_isha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="00:00" android:textSize="10sp" android:gravity="center" android:textColor="#000000" android:textStyle="bold"/>
    </LinearLayout>
</LinearLayout>
