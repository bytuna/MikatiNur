<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/widget_strip_container">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:weightSum="6">

        <LinearLayout android:id="@+id/container_imsak" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="İmsak" android:textColor="#AAAAAA" android:textSize="10sp" />
            <TextView android:id="@+id/tv_imsak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/container_gunes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Güneş" android:textColor="#AAAAAA" android:textSize="10sp" />
            <TextView android:id="@+id/tv_gunes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/container_ogle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Öğle" android:textColor="#AAAAAA" android:textSize="10sp" />
            <TextView android:id="@+id/tv_ogle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/container_ikindi" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="İkindi" android:textColor="#AAAAAA" android:textSize="10sp" />
            <TextView android:id="@+id/tv_ikindi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/container_aksam" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Akşam" android:textColor="#AAAAAA" android:textSize="10sp" />
            <TextView android:id="@+id/tv_aksam" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:id="@+id/container_yatsi" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yatsı" android:textColor="#AAAAAA" android:textSize="10sp" />
            <TextView android:id="@+id/tv_yatsi" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="00:00" android:textColor="#FFFFFF" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>