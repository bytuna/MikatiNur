<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+ için: Firebase oturum verisi bulut yedeklemesine ve cihaz aktarımına girmez. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.google.firebase.auth.api.Store.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="file" path="datastore/com.google.firebase.auth.api.Store.PERSISTENT" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.google.firebase.auth.api.Store.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="file" path="datastore/com.google.firebase.auth.api.Store.PERSISTENT" />
    </device-transfer>
</data-extraction-rules>
