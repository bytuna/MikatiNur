    "seviye": 5,
    "baslik": "Bu kısım, ehl-i dalaletin sahife-i zulmaniyesini tasvir eden levhadır",
    "sayfa_no": 150
  },
  {
    "seviye": 5,
    "baslik": "Bu sahife, ehl-i hidayetin sahife-i nuraniyesini tasvir eden levhadır",
    "sayfa_no": 150
  },
  {
    "seviye": 5,
    "baslik": "Maraz-ı Vesveseye Müptela Olanlara Derstir",
    "sayfa_no": 151
  },
  {
    "seviye": 5,
    "baslik": "On Üçüncü Lem’a’nın On İkinci İşaret’inden Dördüncü Sual",
    "sayfa_no": 156
  },
  {
    "seviye": 5,
    "baslik": "On Üçüncü Lem’a’nın On Üçüncü İşaret’inin Üçüncü Nokta’sından",
    "sayfa_no": 158
  },
  {
    "seviye": 5,
    "baslik": "Nur’un bir kahramanı Mehmed Kaya’nın Risale-i Nur hakkında bir takrizidir",
    "sayfa_no": 159
  },
  {
    "seviye": 5,
    "baslik": "Ecnebi Feylesofların Kur’an’ı tasdiklerine dair şehadetleri",
    "sayfa_no": 181
  },
  {
    "seviye": 5,
    "baslik": "Sana muasır bir vücud olamadığımdan müteessirim ey Muhammed (asm)!",
    "sayfa_no": 181
  },
  {
    "seviye": 5,
    "baslik": "En temiz ve en doğru din müslümanlıktır",
    "sayfa_no": 182
  },
  {
    "seviye": 5,
    "baslik": "Zamanlar geçtikçe Kur’an’ın ulvi sırları inkişaf ediyor",
    "sayfa_no": 182
  },
  {
    "seviye": 5,
    "baslik": "Zat-ı Kibriya hakkındaki âyetlerin ulviyeti ve Kur’an’ın kudsî nezaheti",
    "sayfa_no": 185
  },
  {
    "seviye": 5,
    "baslik": "Kur’an serâpa samimiyet ve hakkaniyetle doludur",
    "sayfa_no": 185
  },
  {
    "seviye": 5,
    "baslik": "Müslümanlık, tecessüd ve teslis akidesini reddeder",
    "sayfa_no": 185
  },
  {
    "seviye": 5,
    "baslik": "Hâlık’ın hukukuyla mahlukatın hukukunu en mükemmel surette ancak Müslümanlık tarif etmiştir",
    "sayfa_no": 186
  },
  {
    "seviye": 5,
    "baslik": "Kur’an ile kavanin-i tabiiye arasında tam bir ahenk vardır",
    "sayfa_no": 186
  },
  {
    "seviye": 5,
    "baslik": "Kur’an, bütün iyilik ve fazilet esaslarını muhtevidir. İnsanı her türlü dalaletlerden korur.",
    "sayfa_no": 186
  },
  {
    "seviye": 5,
    "baslik": "Kur’an öyle bir Peygamber sesidir ki onu bütün dünya dinleyebilir. Bu sesin aksi saraylarda, çöllerde, şehirlerde, devletlerde çınlar!",
    "sayfa_no": 187
  },
  {
    "seviye": 5,
    "baslik": "Kur’an’ın cihan-şümul hakikati: Kur’an, Allah’ın birliğine inanmak hakikat-i kübrasını ilan eder",
    "sayfa_no": 187
  },
  {
    "seviye": 5,
    "baslik": "Kur’an’ın lisanı, nezahet ve belâgat itibarıyla nazirsizdir. Kur’an bizatihî muhteşem bir mu’cizedir",
    "sayfa_no": 188
  },
  {
    "seviye": 5,
    "baslik": "Kur’an, beşeriyete İlahî bir lütuftur. Kur’an, muzaffer cumhuriyetler meydana getirmiştir",
    "sayfa_no": 189
  },
  {
    "seviye": 5,
    "baslik": "Müslümanlık, dünyanın kıvamı olan bir dindir; cihan medeniyetinin istinad ettiği temelleri muhtevidir",
    "sayfa_no": 190
  },
  {
    "seviye": 5,
    "baslik": "Kur’an bütün dinî kitaplara faiktir",
    "sayfa_no": 191
  },
  {
    "seviye": 5,
    "baslik": "Kur’an âyetleri İslâmiyet’in muhteşem bünyesinde altın bir kordon gibi işlenmiştir",
    "sayfa_no": 191
  },
  {
    "seviye": 5,
    "baslik": "Resul-i Ekrem idrak ve şuur timsalidir",
    "sayfa_no": 192
